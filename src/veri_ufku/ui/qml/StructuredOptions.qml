import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
ColumnLayout {
    id: panel
    signal helpRequested(var origin, string context)
    property bool json: imports.formatId === "json" || imports.formatId === "jsonl"
    property bool excel: imports.formatId === "xlsx" || imports.formatId === "ods"
    readonly property bool phase30: ["parquet_dataset", "arrow_dataset", "avro", "orc", "hdf5", "xml", "fixed_width", "spss", "stata", "sas"].indexOf(imports.formatId) >= 0
    ArrayOptions { visible: ["netcdf", "zarr", "hdf5_array"].indexOf(imports.formatId) >= 0; Layout.fillWidth: true; onHelpRequested: function(origin, context) { panel.helpRequested(origin, context) } }
    enabled: !imports.busy
    UiLabel { visible: panel.phase30; text: "Native türler ve metadata korunur. Etiket, eksik değer ve ağırlık tanımı otomatik analiz kararı değildir. Hive partition değerleri String olarak korunur."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiLabel { visible: imports.formatId === "hdf5"; text: "HDF5 tablo key · bir boyutlu compound dataset; external/soft/virtual link ve özel filtreler kapalı."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiCombo { objectName: "hdfKey"; accessibleLabel: "HDF5 tablo key"; visible: imports.formatId === "hdf5"; model: ["Key seç…"].concat(imports.choices.sheets || []); currentIndex: Math.max(0, model.indexOf(imports.settings.sheet || "")); onActivated: if (currentIndex > 0) imports.setOption("sheet", currentText); Layout.fillWidth: true }
    UiLabel { visible: imports.formatId === "xml"; text: "XML kayıt yolu · ör. /root/record. DTD/entity/external kaynak kapalı; düz alan ve kayıt attributes desteklenir."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { objectName: "xmlRecordPath"; Accessible.name: "XML kayıt yolu"; visible: imports.formatId === "xml"; text: imports.settings.record_path || ""; placeholderText: "/root/record"; onEditingFinished: imports.setOption("record_path", text); Layout.fillWidth: true }
    UiLabel { visible: imports.formatId === "fixed_width"; text: "Karakter genişlikleri virgülle, sütun adları | ile ayrılır. Boşluklar korunur; satır tam genişlikle eşleşmeli."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { objectName: "fixedWidths"; Accessible.name: "Sabit karakter genişlikleri"; visible: imports.formatId === "fixed_width"; text: (imports.settings.widths || []).join(","); placeholderText: "4,12,8"; onEditingFinished: imports.setOption("widths", text); Layout.fillWidth: true }
    UiTextField { objectName: "fixedNames"; Accessible.name: "Sabit genişlik sütun adları"; visible: imports.formatId === "fixed_width"; text: (imports.settings.column_names || []).join("|"); placeholderText: "kimlik|ad|tutar"; onEditingFinished: imports.setOption("column_names", text); Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Sabit metin encoding"; visible: imports.formatId === "fixed_width"; model: ["utf-8", "cp1254", "iso8859-9"]; currentIndex: model.indexOf(imports.settings.encoding); onActivated: imports.setOption("encoding", currentText); Layout.fillWidth: true }
    UiLabel { visible: panel.phase30; text: "Şema çözümü · birleştirmeden önce çözüm önizlemesini inceleyin."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiCombo { objectName: "schemaPolicy"; accessibleLabel: "Şema çözümü"; property string helpContext: "import-schema-evolution"; visible: panel.phase30; property var values: ["strict", "union"]; model: ["Farklı şemada dur", "Eksik alan null; yalnız kayıpsız tür genişletme"]; currentIndex: values.indexOf(imports.settings.schema_policy); onActivated: imports.setOption("schema_policy", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.phase30; text: "Tam içe aktarma satır sınırı"; Layout.fillWidth: true }
    UiSpinBox { objectName: "advancedRowLimit"; Accessible.name: "Tam içe aktarma satır sınırı"; visible: panel.phase30; from: 1; to: 10000000; editable: true; value: imports.settings.max_rows || 10000000; onValueModified: imports.setOption("max_rows", value); Layout.fillWidth: true }
    UiLabel { visible: ["spss", "stata", "sas"].indexOf(imports.formatId) >= 0; text: "İsteğe bağlı ağırlık sütunu beyanı · otomatik uygulanmaz"; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { objectName: "importWeight"; Accessible.name: "Ağırlık sütunu beyanı"; property string helpContext: "import-category-labels"; visible: ["spss", "stata", "sas"].indexOf(imports.formatId) >= 0; text: imports.settings.weight_column || ""; onEditingFinished: imports.setOption("weight_column", text); Layout.fillWidth: true }
    UiLabel { visible: panel.phase30 && imports.formatMetadata.length > 0; text: "Format metadata ve şema çözüm planı"; Layout.fillWidth: true }
    ScrollView { id: metadataScroll; visible: panel.phase30 && imports.formatMetadata.length > 0; Layout.fillWidth: true; Layout.preferredHeight: 200; contentWidth: availableWidth; clip: true; UiLabel { width: metadataScroll.availableWidth; text: imports.formatMetadata; textFormat: Text.PlainText; wrapMode: Text.WrapAnywhere } }
    UiLabel { text: "Seçimler aynı değişmez kopyaya uygulanır. Önizleme en fazla 200 kaynak kaydıdır; tam import türleri yeniden doğrular. JSON sayıları Decimal/büyük integer olarak incelenir. json_text açık ve kayıpsız JSON metni dönüşümüdür; metin değerleri de tırnaklarıyla saklanır."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiLabel { visible: panel.json; text: "Kayıt yolu: kök liste için boş, nested için JSON Pointer (ör. /payload/records)."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiCombo { accessibleLabel: "JSON kayıt yolu"; objectName: "jsonRecordPaths"; visible: imports.formatId === "json"; model: imports.choices.record_paths || []; onActivated: imports.setOption("record_path", currentText); Layout.fillWidth: true }
    UiTextField { Accessible.name: "Kayıt yolu: kök liste için boş, nested için JSON Pointer (ör. /payload/records)."; objectName: "jsonRecordPath"; property string helpContext: "import-json-path"; visible: imports.formatId === "json"; text: imports.settings.record_path || ""; placeholderText: "/payload/records"; onEditingFinished: imports.setOption("record_path", text); Layout.fillWidth: true }
    UiCheckBox { id: flattenOption; Layout.fillWidth: true; Layout.minimumWidth: 0; contentItem: UiLabel { text: flattenOption.text; leftPadding: flattenOption.indicator.width + flattenOption.spacing; wrapMode: Text.Wrap; verticalAlignment: Text.AlignVCenter } objectName: "jsonFlatten"; property string helpContext: "import-flatten"; visible: panel.json; text: "Nesne alanlarını düzleştir (listeleri açmaz)"; checked: imports.settings.flatten || false; onClicked: imports.setOption("flatten", checked) }
    UiLabel { visible: panel.json; text: "Liste yolları: " + (imports.choices.list_paths || []).join(", ") + "\nAçılacak yolları | ile ayırın. İki listenin uzunluğu 2 ve 3 ise tek kayıt 6 satır üretir. Boş/null liste bir satır korunur. Seçimden sonra yeniden önizleyin."; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { Accessible.name: "Liste yolları: "; objectName: "jsonExpandLists"; visible: panel.json; text: (imports.settings.expand_lists || []).join("|"); placeholderText: "/items|/tags"; onEditingFinished: imports.setOption("expand_lists", text); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: (imports.formatId === "ods" ? "ODS sayfası · tarih sistemi " : "Excel sayfası · tarih sistemi ") + (imports.choices.date_system || "?"); Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Sayfa veya tablo"; objectName: "excelSheet"; property string helpContext: "import-excel-sheet"; visible: panel.excel || imports.formatId === "sqlite"; model: imports.choices.sheets || []; currentIndex: Math.max(0, model.indexOf(imports.settings.sheet || "")); onActivated: imports.setOption("sheet", currentText); Layout.fillWidth: true }
    UiLabel { visible: imports.formatId === "sqlite"; text: "Salt okunur SQLite tablosu. " + (imports.choices.formula_behavior || ""); wrapMode: Text.WordWrap; Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Veri aralığı (ör. A1:D100; boş: sayfa boyutu)"; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { Accessible.name: "Veri aralığı (ör. A1:D100; boş: sayfa boyutu)"; objectName: "excelRange"; visible: panel.excel; text: imports.settings.cell_range || ""; placeholderText: "Veri aralığı: A1:D100 (boş: sayfa boyutu)"; onEditingFinished: imports.setOption("cell_range", text); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Başlık satırı (0: başlıksız)"; Layout.fillWidth: true }
    UiSpinBox { Accessible.name: "Başlık satırı (0: başlıksız)"; objectName: "excelHeader"; visible: panel.excel; from: 0; to: 1048576; editable: true; value: imports.settings.header_row || 0; onValueModified: imports.setOption("header_row", value); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Başlık fiziksel satır numarasıdır; 0 başlıksız. " + (imports.choices.formula_behavior || ""); wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiLabel { visible: panel.json || panel.excel; text: "Karışık tür / hassasiyet sınırı"; Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Karışık tür / hassasiyet sınırı"; objectName: "mixed_policy"; visible: panel.json || panel.excel; property var values: ["reject", "json_text"]; model: ["Durdur: türü kullanıcı seçsin", "Kayıpsız JSON metnine dönüştür"]; currentIndex: values.indexOf(imports.settings.mixed_policy); onActivated: imports.setOption("mixed_policy", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Birleşik hücre"; Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Birleşik hücre"; objectName: "merged_cells"; visible: panel.excel; property var values: ["reject", "anchor"]; model: [qsTr("Durdur"), "Yalnız sol üst hücre"]; currentIndex: values.indexOf(imports.settings.merged_cells); onActivated: imports.setOption("merged_cells", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Boş satır"; Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Boş satır"; objectName: "blank_rows"; visible: panel.excel; property var values: ["keep", "skip"]; model: ["Boş satırları koru", "Boş satırları çıkar"]; currentIndex: values.indexOf(imports.settings.blank_rows); onActivated: imports.setOption("blank_rows", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Formül hücresi"; Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Formül hücresi"; objectName: "formulas"; visible: panel.excel; property var values: ["formula", "text", "cached"]; model: ["Formülü göster (= ile)", "Formül metnini göster", "Dosyadaki önbellek değerini al"]; currentIndex: values.indexOf(imports.settings.formulas); onActivated: imports.setOption("formulas", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.excel; text: "Excel tarih"; Layout.fillWidth: true }
    UiCombo { accessibleLabel: "Excel tarih"; objectName: "excel_dates"; visible: panel.excel; property var values: ["dates", "serial"]; model: ["Saat dilimsiz tarih", "Asıl seri sayıyı koru"]; currentIndex: values.indexOf(imports.settings.excel_dates); onActivated: imports.setOption("excel_dates", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.json || panel.excel; text: qsTr("Bozuk kayıt"); Layout.fillWidth: true }
    UiCombo { accessibleLabel: qsTr("Bozuk kayıt"); objectName: "bad_rows"; visible: panel.json || panel.excel; property var values: ["stop", "quarantine"]; model: [qsTr("Durdur"), "Raporlu karantina"]; currentIndex: values.indexOf(imports.settings.bad_rows); onActivated: imports.setOption("bad_rows", values[currentIndex]); Layout.fillWidth: true }
    UiLabel { visible: panel.json || panel.excel; text: "Açık tür dönüşümü için tarih biçimi"; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { Accessible.name: "Açık tür dönüşümü için tarih biçimi"; visible: panel.json || panel.excel; text: imports.settings.date_format || ""; placeholderText: "Açık tarih dönüşümü: %Y-%m-%d"; onEditingFinished: imports.setOption("date_format", text); Layout.fillWidth: true }
    UiLabel { visible: panel.json || panel.excel; text: "Açık datetime dönüşümü için saat dilimi (boş: saat dilimsiz)"; wrapMode: Text.Wrap; Layout.fillWidth: true }
    UiTextField { Accessible.name: "Açık datetime dönüşümü için saat dilimi (boş: saat dilimsiz)"; visible: panel.json || panel.excel; text: imports.settings.timezone || ""; placeholderText: "Açık datetime dönüşümü: Europe/Istanbul; boş: naive"; onEditingFinished: imports.setOption("timezone", text); Layout.fillWidth: true }
    UiLabel { visible: ["parquet", "ipc", "ipc_stream"].indexOf(imports.formatId) >= 0; text: "Parquet nullable, Decimal, integer, tarih, zaman birimi, timezone ve list/struct türleri korunur. Desteklenmeyen tür hata verir. Nested alanları bu adaptör açmaz. Naive tarih UTC kabul edilmez."; wrapMode: Text.Wrap; Layout.fillWidth: true }
}
