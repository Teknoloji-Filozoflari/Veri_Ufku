import QtQuick
import QtQuick.Controls
import QtQuick.Layouts

ColumnLayout {
    id:panel
    objectName:"uncertaintyPanel"
    property var protocol
    property bool protocolBlocked:false
    property string helpContext:"model.uncertainty"
    signal helpRequested(var origin,string context)
    readonly property string purpose:(preparation.report.spec||{}).purpose||""
    readonly property bool classification:purpose==="classification"
    readonly property var methods:validation.uncertaintyMethods(purpose)
    readonly property var metadata:validation.summaryReport.uncertainty||{}
    readonly property var evaluation:metadata.schema?(validation.summaryReport.evaluations||[])[0]||{}:{}
    readonly property var result:evaluation.uncertainty_report||{}
    function config(){return {model:classification?(base.currentIndex===0?"logistic":"forest"):(method.currentValue==="quantile"||method.currentValue==="cqr"?"quantile":base.currentIndex===0?"ridge":"forest"),calibration:classification?(method.currentValue==="isotonic"?"isotonic":calibration.currentValue||"sigmoid"):"none",prediction:classification?(sets.checked?"sets":"none"):method.currentValue||"interval",alpha:Number(alpha.text),bins:Number(bins.text),threshold:classification?(threshold.currentValue||"cost"):"default",positive_class:classification&&positive.count===2?(positive.currentValue||""):"",false_positive_cost:Number(fp.text),false_negative_cost:Number(fn.text),min_precision:Number(precision.text),min_recall:Number(recall.text)}}
    Connections { target:validation;function onSelectUncertainty(value){expanded.checked=true;method.currentIndex=panel.methods.findIndex(m=>m.id===value)} }
    spacing:Theme.sm
    UiCheckBox { id:expanded;objectName:"uncertaintyExpanded";text:"Faz50 olasılık kalibrasyonu ve predictive belirsizlik";Layout.fillWidth:true }
    ColumnLayout { visible:expanded.checked;Layout.fillWidth:true;spacing:Theme.sm
        UiLabel { text:"Proper train → probability calibration → conformal calibration → validation → final test";font.bold:true;Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiLabel { text:"Her bölüm bağımsız kayıtlardır; grup/zaman protokolü ve hedef ufku korunur. Yetersiz grup/sınıf/coverage n varsa durur; random fallback yok. Model ve hazırlık yalnız proper train'de fit edilir. Eşik validation'da seçilir. Final test kayıtlı paketi refit yapmadan kullanır.";Layout.fillWidth:true;wrapMode:Text.Wrap }
        ColumnLayout { enabled:!validation.busy;Layout.fillWidth:true
            UiCombo { id:method;objectName:"uncertaintyMethod";onActivated:validation.invalidate();accessibleLabel:"Kalibrasyon veya predictive yöntem";model:panel.methods;textRole:"label";valueRole:"id";Layout.fillWidth:true }
            UiCombo { id:base;objectName:"uncertaintyBase";onActivated:validation.invalidate();visible:panel.classification||(method.currentValue!=="quantile"&&method.currentValue!=="cqr");accessibleLabel:"Belirsizlik temel modeli";model:panel.classification?["Logistic regression","Random forest"]:["Ridge regression","Random forest"];Layout.fillWidth:true }
            UiLabel { text:"Native bounded CPU: 1000 kayıt/32 özellik. Logistic/forest probability; Ridge/forest residual interval; gradient quantile/CQR. Diğer family/sparse/weights/TF-IDF için bu adapter kapalı. Quantile yalnız ilgili şablonda, olmayan interval üretilmez.";Layout.fillWidth:true;wrapMode:Text.Wrap;color:Theme.secondary }
            UiCombo { id:calibration;objectName:"uncertaintyCalibration";onActivated:validation.invalidate();accessibleLabel:"Probability calibration seçimi";visible:panel.classification;model:[{id:"sigmoid",label:"Sigmoid"},{id:"isotonic",label:"Isotonic"},{id:"none",label:"Kalibrasyon yok"}];textRole:"label";valueRole:"id";Layout.fillWidth:true }
            UiLabel { visible:panel.classification;text:"Isotonic küçük örnekte aşırı öğrenebilir; calibration n ve uyarısı sonuçta. Multiclass OvR olasılıklar yeniden normalize edilir; eşik yolu binary içindir.";Layout.fillWidth:true;wrapMode:Text.Wrap }
            UiCheckBox { id:sets;objectName:"uncertaintySets";onToggled:validation.invalidate();visible:panel.classification;checked:true;text:"Ayrı conformal calibration ile prediction sets";Layout.fillWidth:true }
            UiLabel { text:"Alpha (0.05..0.5); nominal coverage = 1 − alpha";Layout.fillWidth:true;wrapMode:Text.Wrap }
            UiTextField { id:alpha;objectName:"uncertaintyAlpha";onTextEdited:validation.invalidate();Accessible.name:"Conformal alpha";text:"0.1";Layout.fillWidth:true }
            UiLabel { visible:panel.classification;text:"Reliability diagram uniform bin sayısı (2..20)";Layout.fillWidth:true }
            UiTextField { id:bins;objectName:"uncertaintyBins";onTextEdited:validation.invalidate();Accessible.name:"Reliability bin sayısı";text:"10";visible:panel.classification;Layout.fillWidth:true }
            UiCombo { id:positive;objectName:"uncertaintyPositive";onActivated:validation.invalidate();accessibleLabel:"Binary pozitif sınıf";visible:panel.classification;model:(preparation.report.target||{}).class_distribution||[];textRole:"label";valueRole:"label";Layout.fillWidth:true }
            UiCombo { id:threshold;objectName:"uncertaintyThreshold";onActivated:validation.invalidate();accessibleLabel:"Validation eşik seçim amacı";visible:panel.classification;model:[{id:"default",label:"Default (multiclass argmax / binary 0.5)"},{id:"cost",label:"Maliyet minimum"},{id:"precision",label:"Precision maximum + constraints"},{id:"recall",label:"Recall maximum + constraints"}];textRole:"label";valueRole:"id";currentIndex:1;Layout.fillWidth:true }
            UiLabel { visible:panel.classification;text:"Yanlış pozitif maliyeti / yanlış negatif maliyeti (her biri ≥0; toplam >0)";Layout.fillWidth:true;wrapMode:Text.Wrap }
            UiTextField { id:fp;objectName:"uncertaintyFPCost";onTextEdited:validation.invalidate();Accessible.name:"Yanlış pozitif maliyeti";text:"1";visible:panel.classification;Layout.fillWidth:true }
            UiTextField { id:fn;objectName:"uncertaintyFNCost";onTextEdited:validation.invalidate();Accessible.name:"Yanlış negatif maliyeti";text:"1";visible:panel.classification;Layout.fillWidth:true }
            UiLabel { visible:panel.classification;text:"Minimum precision / minimum recall (0..1; 0 constraint yok)";Layout.fillWidth:true;wrapMode:Text.Wrap }
            UiTextField { id:precision;objectName:"uncertaintyMinPrecision";onTextEdited:validation.invalidate();Accessible.name:"Minimum validation precision";text:"0";visible:panel.classification;Layout.fillWidth:true }
            UiTextField { id:recall;objectName:"uncertaintyMinRecall";onTextEdited:validation.invalidate();Accessible.name:"Minimum validation recall";text:"0";visible:panel.classification;Layout.fillWidth:true }
            UiButton { objectName:"uncertaintyRun";text:"Ayrı bölmelerle eğit / kalibre et / validation raporu kaydet";primary:true;multiline:true;Layout.fillWidth:true;enabled:validation.canRun&&!panel.protocolBlocked&&panel.methods.length>0;onClicked:validation.createUncertainty(JSON.stringify(panel.protocol),JSON.stringify(panel.config())) }
        }
        UiLabel { objectName:"uncertaintyScope";text:panel.metadata.schema?(validation.current?"Güncel":"Kayıtlı/eski")+" · Proper train n="+panel.metadata.train_n+" · probability calibration allocated/fit n="+panel.metadata.calibration_n+"/"+panel.metadata.probability_calibration_used_n+" · conformal allocated/used n="+panel.metadata.conformal_n+"/"+panel.metadata.conformal_calibration_used_n+" · validation n="+panel.metadata.validation_n+"\n"+(panel.evaluation.scope||"")+" · evaluation n="+panel.result.n+" · "+(panel.metadata.warnings||[]).join("; "):"Henüz belirsizlik sonucu yok";Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiLabel { text:"Brier kalibrasyonu tek başına ölçmez: ayırt etme ve veri belirsizliği de etkiler. Log-loss/Brier daha küçük daha iyi; reliability her sınıf için bir-bin ortalama olasılığını gözlenen oranla karşılaştırır. Boş bin atlanır; n görünür. Validation eşik için tekrar kullanıldığından final rapor ayrıca alınır.";Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiLabel { objectName:"uncertaintyProbability";text:JSON.stringify(panel.result.probability?{log_loss:panel.result.probability.log_loss,brier:panel.result.probability.brier,raw_log_loss:(panel.result.uncalibrated_probability||{}).log_loss,raw_brier:(panel.result.uncalibrated_probability||{}).brier,brier_scale:panel.result.probability.brier_scale,label_order:panel.result.probability.label_order}:{});Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiCombo { id:curve;objectName:"uncertaintyCurveClass";accessibleLabel:"Reliability diagram sınıfı";visible:!!panel.result.probability;model:(panel.result.probability||{}).reliability||[];textRole:"label";Layout.fillWidth:true }
        ReliabilityDiagram { objectName:"uncertaintyReliability";visible:!!panel.result.probability;classLabel:((curve.model||[])[curve.currentIndex]||{}).label||"";scope:panel.evaluation.scope||"";n:Number(panel.result.n||0);bins:Number((panel.metadata.spec||{}).bins||0);points:((curve.model||[])[curve.currentIndex]||{}).points||[];Layout.fillWidth:true;Layout.preferredHeight:240 }
        Repeater { model:((curve.model||[])[curve.currentIndex]||{}).points||[];UiLabel { required property var modelData;text:"Bin "+modelData.bin+" · n="+modelData.n+" · mean p="+modelData.mean_probability.toFixed(4)+" · positive rate="+modelData.fraction_positive.toFixed(4);Layout.fillWidth:true;wrapMode:Text.Wrap } }
        UiLabel { objectName:"uncertaintyDecision";text:"Evaluation karar maliyeti / precision / recall: "+JSON.stringify(panel.result.decision||{});Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiLabel { objectName:"uncertaintyCoverage";text:"Nominal coverage="+(typeof panel.result.nominal_coverage==="number"?panel.result.nominal_coverage.toFixed(3):"—")+" · empirical coverage="+(typeof panel.result.empirical_coverage==="number"?panel.result.empirical_coverage.toFixed(3):"—")+" · mean width="+(typeof panel.result.mean_width==="number"?panel.result.mean_width.toFixed(4):"—")+" · mean set size="+(typeof panel.result.mean_set_size==="number"?panel.result.mean_set_size.toFixed(3):"—")+"\nEmpty/full sets="+(typeof panel.result.empty_set_n==="number"?panel.result.empty_set_n:"—")+"/"+(typeof panel.result.full_set_n==="number"?panel.result.full_set_n:"—")+" · quantile crossings="+(typeof panel.result.quantile_crossing_n==="number"?panel.result.quantile_crossing_n:"—");Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiLabel { text:"Conformal exchangeability varsayımı ister; grup/zaman ayrımı bağımlılığı ortadan kaldırdığını kanıtlamaz. Nominal coverage her alt grupta veya gelecek dağılımda garanti değildir. Predictive interval yeni gözlemi kapsar; parametre CI değildir. Quantile aralığı tek başına conformal guarantee değildir. Quantile crossing varsa açık pointwise min/max düzenlemesi ve sayısı kaydedilir.";color:Theme.warning;Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiLabel { text:"Binary threshold / validation selection: "+JSON.stringify(panel.metadata.schema?{threshold:(validation.summaryReport.decision||{}).threshold,winner:((validation.summaryReport.decision||{}).threshold_report||{}).winner,positive_class:(validation.summaryReport.decision||{}).positive_class}:{});Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiCheckBox { id:recordIds;objectName:"uncertaintyRecordIds";text:"Önizlemede kaynak satır kimliklerini göster";Layout.fillWidth:true }
        Repeater { model:(panel.evaluation.prediction_records||[]).slice(0,20);UiLabel { required property var modelData;text:"Gerçek="+modelData.actual+" · Tahmin="+modelData.predicted+(modelData.prediction_set?" · Prediction set={"+modelData.prediction_set.join(", ")+"}":"")+(typeof modelData.lower==="number"?" · Predictive interval=["+modelData.lower.toFixed(4)+", "+modelData.upper.toFixed(4)+"]":"")+(recordIds.checked?" · RowId="+modelData.row_id:"");Layout.fillWidth:true;wrapMode:Text.Wrap } }
        UiLabel { text:"İlk20 kayıt önizlemesi; metrikler bölümün tüm kayıtlarında. Calibrator/threshold/q model paketinde, yeni dosya tahmini yalnız transform/predict. Final test, iptal ve kayıt açma aşağıdaki mevcut ortak kontrollerdedir.";Layout.fillWidth:true;wrapMode:Text.Wrap }
        UiButton { visible: false; objectName:"uncertaintyHelp";text:"Olasılık, maliyet, coverage ve belirsizlik türlerini öğren";helpContext:"model.uncertainty";onClicked:panel.helpRequested(this,helpContext) }
    }
}
